#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Layers
 *   0 BASE      Graphite alphas + home-row mods
 *   1 QWERTY    QWERTY alphas (alt base)      <- toggle with &tog 1 on FUN
 *   2 NAV       arrows / editing / clipboard
 *   3 NUM       number pad (left hand)        <- hold right-mid thumb
 *   4 SYM       programming symbols (Swedish) <- hold left-inner thumb
 *   5 FUN       F-keys / bluetooth / reset    <- hold SYM + NUM (left-inner + right-mid)
 *   6 WIN       OS flag, all transparent      <- toggle with &tog 6 on FUN
 *   7 SYMWIN    Windows bracket overrides     <- auto-on when SYM held while WIN active
 *   8 ACC       a/o/e -> Swedish accents      <- hold left-outer thumb (tap = Esc)
 *
 * OS keyboard layout = Swedish ISO (keep it on both macOS and Windows).
 * macOS is the default; hold NUM+SYM and tap the physical X key to toggle Windows mode.
 * The mode resets to macOS after a keyboard reboot.
 * The SYM layer emits the Swedish AltGr/Shift combos for programming symbols,
 * so no EurKEY is needed. { } \ | differ between Windows and macOS Swedish:
 * SYM holds the macOS values by default; the SYMWIN overlay fixes just those
 * four when Windows mode is toggled on.
 */

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        // Left-hand home-row mods. Holds only fire when a RIGHT-hand key
        // (or right thumb) follows -> same-hand rolls always tap.

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        // Right-hand home-row mods. Holds only fire when a LEFT-hand key
        // (or left thumb) follows.

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        // Layer-tap with a sticky modifier on tap: hold = layer, tap = one-shot mod.
        // Use balanced so holding-and-typing reliably reaches the layer.

        lt_sk: lt_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SK";
            #binding-cells = <2>;
            bindings = <&mo>, <&sk>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };

        // Tap = ' , Shift = "  (Swedish: ' is BSLH, " is Shift+2)
        sqt: sqt {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_DQT";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    // Dead keys on Swedish: press the dead key, then SPACE, to emit a literal.
    // (Verified on both Windows and macOS.)

    macros {
        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp LS(EQUAL) &kp SPACE>;
            label = "GRAVE";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp RA(RBKT) &kp SPACE>;
            label = "TILDE";
        };

        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp LS(RBKT) &kp SPACE>;
            label = "CARET";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 14 25>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Hold both inner thumbs (NUM + SYM) to reach the Functions layer.

        functions {
            if-layers = <3 4>;
            then-layer = <5>;
        };

        // When Win mode (6) is toggled on, holding SYM (4) brings up the
        // Windows bracket overrides (7) on top of the macOS-default symbol layer.

        sym_win {
            if-layers = <4 6>;
            then-layer = <7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Graphite";
            bindings = <
&kp TAB    &kp B        &kp L        &kp D         &kp W             &kp Z       &sqt          &kp F              &kp O     &kp U     &kp J        &kp LS(COMMA)
&kp ESC    &hml LGUI N  &hml LALT R  &hml LCTRL T  &kp S             &kp G       &hmr LCTRL Y  &kp H              &kp A     &kp E     &hmr LGUI I  &kp COMMA
&kp LSHFT  &kp Q        &kp X        &kp M         &kp C             &kp V       &kp K         &kp P              &kp DOT   &kp FSLH  &kp LS(N7)   &kp ENTER
                                     &lt 8 ESC     &lt_sk 2 LSHFT    &lt 4 SPACE  &kp BSPC      &lt_sk 3 RSHFT     &kp RALT
            >;
        };

        qwerty {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp E         &kp R          &kp T      &kp Y         &kp U     &kp I      &kp O          &kp P     &kp LBKT
&kp ESC    &hml LGUI A  &hml LALT S  &hml LCTRL D  &kp F          &kp G      &hmr LCTRL H  &kp J     &kp K      &kp L          &hmr LGUI SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V          &kp B      &kp N         &kp M     &kp COMMA  &kp DOT        &kp FSLH  &kp ENTER
                                     &lt 8 ESC     &lt_sk 2 LSHFT &lt 4 SPACE  &kp BSPC      &lt_sk 3 RSHFT  &kp RALT
            >;
        };

        navigation {
            display-name = "Nav";
            bindings = <
&trans  &trans         &trans        &trans          &trans            &trans  &trans         &trans          &kp FSLH        &kp MINUS     &trans           &kp BSPC
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans  &trans         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp HOME
&trans  &trans         &trans        &trans          &trans            &trans  &kp C_AC_UNDO  &kp C_AC_COPY   &kp C_AC_PASTE  &kp C_AC_CUT  &kp DELETE       &kp END
                                     &kp LEFT_META   &trans            &trans  &kp BACKSPACE  &trans          &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
&trans  &kp LS(BSLH)  &kp N7  &kp N8  &kp N9  &kp MINUS    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LS(N0)    &kp N4  &kp N5  &kp N6  &kp LS(DOT)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp DOT       &kp N1  &kp N2  &kp N3  &kp FSLH     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &kp N0  &trans                &trans  &trans  &trans
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&trans  &trans  &kp LS(N6)  &kp LS(BSLH)  &kp LS(N8)  &kp LS(N9)    &grave         &kp RA(LS(N8))  &kp RA(LS(N9))  &kp NON_US_BSLH  &kp LS(NON_US_BSLH)  &kp LS(DOT)
&trans  &trans  &kp RA(N4)  &kp LS(N5)    &caret      &trans        &kp LS(MINUS)  &kp RA(N8)      &kp RA(N9)      &sqt              &kp RA(LS(N7))        &kp LS(COMMA)
&trans  &trans  &kp LS(N1)  &kp RA(N2)    &kp LS(N3)  &kp LS(FSLH)  &kp FSLH       &kp MINUS       &kp LS(N0)      &kp LS(N7)        &kp RA(N7)            &tilde
                                &trans       &trans      &trans        &trans         &trans          &trans
            >;
        };

        functions {
            display-name = "Functions";
            bindings = <
&kp F1           &kp F2        &kp F3  &kp F4  &kp F5      &kp F6        &kp F7       &kp F8     &kp F9       &kp F10     &kp F11          &kp F12
&bt BT_CLR_ALL   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &trans      &trans        &trans       &kp PRINTSCREEN  &trans
&rgb_ug RGB_TOG  &sys_reset    &tog 6  &tog 1  &bl BL_TOG  &bt BT_CLR    &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                           &trans  &trans  &trans        &trans       &trans     &trans
            >;
        };

        winflag {
            display-name = "Windows";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        symwin {
            display-name = "SymWin";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RA(N7)  &kp RA(N0)  &trans  &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans  &kp RA(MINUS)        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans  &kp RA(NON_US_BSLH)  &trans
                        &trans  &trans  &trans  &trans  &trans      &trans
            >;
        };

        accents {
            display-name = "Accents";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SEMI  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT   &kp LBKT  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
                        &trans  &trans  &trans  &trans  &trans    &trans
            >;
        };
    };
};
