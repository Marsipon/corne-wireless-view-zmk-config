#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/*
 * Layers (WIN must stay at 1: it sits right above BASE so every other layer overrides it)
 *   0 BASE      Graphite alphas + home-row mods (macOS mods by default)
 *   1 WIN       Windows flag: swaps Ctrl/GUI home-row mods  <- toggle with &tog 1 on FUN
 *   2 NAV       vim-style arrows (<- v ^ ->) / Home End PgUp PgDn / zoom  <- hold left-mid thumb
 *   3 NUM       number pad (left hand)               <- hold right-outer thumb
 *   4 SYM       programming symbols (Swedish)        <- hold left-inner thumb (Space)
 *   5 FUN       F-keys / bluetooth / reset           <- hold NUM + SYM
 *   6 SYMWIN    Windows { } \ | overrides            <- auto-on when SYM + WIN
 *   7 ACC       a/o/e -> Swedish a-ring/a-uml/o-uml  <- hold left-outer thumb (tap = Esc)
 *   8 NAVWIN    Windows NAV mods + Ctrl zoom         <- auto-on when NAV + WIN
 *
 * Thumbs:  L: Esc/ACC  NAV  Space/SYM      R: Backspace  Shift  NUM
 * Home row mods (macOS): left N R T S = Ctrl Alt Cmd Shift, right H A E I = Shift Cmd Alt Ctrl.
 * Windows swaps Ctrl<->GUI so the shortcut modifier stays on the middle finger (T / A).
 *
 * OS keyboard layout = Swedish ISO (keep it on both macOS and Windows).
 * macOS is the default; hold NUM+SYM and tap the physical X key to toggle Windows mode.
 * The mode resets to macOS after a keyboard reboot.
 * The SYM layer emits the Swedish AltGr/Shift combos for programming symbols,
 * so no EurKEY is needed. { } \ | differ between Windows and macOS Swedish:
 * SYM holds the macOS values by default; the SYMWIN overlay fixes just those
 * four when Windows mode is toggled on.
 */

&soft_off { hold-time-ms = <2000>; };

// Keep Caps Word alive through the Swedish underscore (Shift+'-' key) for snake_case.
&caps_word { continue-list = <LS(FSLH) BACKSPACE DELETE>; };

/ {
    behaviors {
        // Left-hand home-row mods. Holds only fire when a RIGHT-hand key
        // (or right thumb) follows -> same-hand rolls always tap.

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        // Right-hand home-row mods. Holds only fire when a LEFT-hand key
        // (or left thumb) follows.

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        // Layer-tap for the Space/Esc thumbs: hold = layer, tap = key.
        // Balanced (not the default tap-preferred) so a symbol pressed right after the
        // thumb reaches the layer instead of sending Space/Esc plus a plain letter.

        lt_bal: lt_bal {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BAL";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
        };

        // Tap = ' , Shift = "  (Swedish: ' is BSLH, " is Shift+2)
        sqt: sqt {
            compatible = "zmk,behavior-mod-morph";
            label = "SQT_DQT";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    // Dead keys on Swedish: press the dead key, then SPACE, to emit a literal.
    // (Verified on both Windows and macOS.)

    macros {
        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp LS(EQUAL) &kp SPACE>;
            label = "GRAVE";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp RA(RBKT) &kp SPACE>;
            label = "TILDE";
        };

        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings = <&kp LS(RBKT) &kp SPACE>;
            label = "CARET";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 14 25>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Hold both inner thumbs (NUM + SYM) to reach the Functions layer.

        functions {
            if-layers = <3 4>;
            then-layer = <5>;
        };

        // When Win mode (1) is toggled on, holding SYM (4) brings up the
        // Windows bracket overrides (6) on top of the macOS-default symbol layer.

        sym_win {
            if-layers = <4 1>;
            then-layer = <6>;
        };

        // Same for NAV (2): Windows uses Ctrl for zoom and has Ctrl on the middle finger.

        nav_win {
            if-layers = <2 1>;
            then-layer = <8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Graphite";
            bindings = <
&kp TAB     &kp B         &kp L        &kp D        &kp W         &kp Z  &sqt   &kp F         &kp O        &kp U        &kp J         &kp LS(COMMA)
&kp ESC     &hml LCTRL N  &hml LALT R  &hml LGUI T  &hml LSHFT S  &kp G  &kp Y  &hmr LSHFT H  &hmr LGUI A  &hmr LALT E  &hmr LCTRL I  &kp COMMA
&caps_word  &kp Q         &kp X        &kp M        &kp C         &kp V  &kp K  &kp P         &kp DOT      &kp FSLH     &kp LS(N7)    &kp ENTER
                                       &lt_bal 7 ESC  &mo 2         &lt_bal 4 SPACE  &kp BSPC  &kp RSHFT     &mo 3
            >;
        };

        winflag {
            display-name = "Windows";
            bindings = <
&trans  &trans       &trans  &trans        &trans  &trans  &trans  &trans  &trans        &trans  &trans       &trans
&trans  &hml LGUI N  &trans  &hml LCTRL T  &trans  &trans  &trans  &trans  &hmr LCTRL A  &trans  &hmr LGUI I  &trans
&trans  &trans       &trans  &trans        &trans  &trans  &trans  &trans  &trans        &trans  &trans       &trans
                             &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };

        navigation {
            display-name = "Nav";
            bindings = <
&trans  &trans     &trans    &trans    &trans     &trans  &kp LG(MINUS)  &trans          &trans          &trans           &trans     &kp DELETE
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans  &kp LG(N0)     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW  &kp HOME
&trans  &trans     &trans    &trans    &trans     &trans  &kp LG(FSLH)   &kp PG_UP       &kp PG_DN       &trans           &trans     &kp END
                             &trans    &trans     &trans  &trans         &trans          &trans
            >;
        };

        numbers {
            display-name = "Numbers";
            bindings = <
&trans  &kp LS(BSLH)  &kp N7  &kp N8  &kp N9  &kp MINUS    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LS(N0)    &kp N4  &kp N5  &kp N6  &kp LS(DOT)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp DOT       &kp N1  &kp N2  &kp N3  &kp FSLH     &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &kp N0  &trans       &trans  &trans  &trans
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
&trans  &kp LS(N1)  &kp LS(N6)  &kp LS(MINUS)  &tilde        &caret        &grave          &kp RA(N8)      &kp RA(N9)      &kp NON_US_BSLH  &kp LS(NON_US_BSLH)  &kp LS(DOT)
&trans  &kp MINUS   &kp FSLH    &kp LS(N0)     &kp LS(BSLH)  &kp LS(N7)    &sqt            &kp LS(N8)      &kp LS(N9)      &kp LS(N2)      &trans               &trans
&trans  &kp LS(N3)  &kp RA(N4)  &kp LS(N5)     &kp RA(N2)    &kp LS(FSLH)  &kp RA(LS(N7))  &kp RA(LS(N8))  &kp RA(LS(N9))  &kp RA(N7)       &trans               &trans
                                &trans         &trans        &trans        &trans          &trans          &trans
            >;
        };

        functions {
            display-name = "Functions";
            bindings = <
&kp F1           &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7       &kp F8            &kp F9       &kp F10     &kp F11          &kp F12
&bt BT_CLR_ALL   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &ext_power EP_ON  &trans       &trans      &kp PRINTSCREEN  &trans
&rgb_ug RGB_TOG  &sys_reset    &tog 1        &trans        &bl BL_TOG    &bt BT_CLR    &trans       &trans            &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                             &trans        &trans        &trans        &trans       &trans            &trans
            >;
        };

        symwin {
            display-name = "SymWin";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans      &trans      &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans      &trans      &trans               &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp RA(MINUS)  &kp RA(N7)  &kp RA(N0)  &kp RA(NON_US_BSLH)  &trans  &trans
                        &trans  &trans  &trans  &trans         &trans      &trans
            >;
        };

        accents {
            display-name = "Accents";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SEMI  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SQT   &kp LBKT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        navwin {
            display-name = "NavWin";
            bindings = <
&trans  &trans    &trans  &trans     &trans  &trans  &kp LC(MINUS)  &trans  &trans  &trans  &trans  &trans
&trans  &kp LGUI  &trans  &kp LCTRL  &trans  &trans  &kp LC(N0)     &trans  &trans  &trans  &trans  &trans
&trans  &trans    &trans  &trans     &trans  &trans  &kp LC(FSLH)   &trans  &trans  &trans  &trans  &trans
                          &trans     &trans  &trans  &trans         &trans  &trans
            >;
        };
    };
};
